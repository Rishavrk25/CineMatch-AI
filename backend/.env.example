# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# MongoDB Configuration (Local or MongoDB Atlas Free Tier)
# Example Local: mongodb://127.0.0.1:27017/cinematch
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cinematch?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cinematch

# Neo4j Knowledge Graph Configuration (Neo4j AuraDB Free or Local Neo4j Desktop)
# Example AuraDB: neo4j+s://xxxxxxxx.databases.neo4j.io
# Example Local: bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Pinecone Vector Database Configuration (Pinecone Serverless Free Tier)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=cinematch-movies
PINECONE_NAMESPACE=movies

# Google Gemini API Configuration (Google AI Studio Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-1.5-flash
